    --//  SCRIPT CARD FACTORY
    --// ═══════════════════════════════════════════════════════
    local function MakeScriptCard(name, desc, color, url, hasExternalKey, banRisk)
        local card = Create("Frame", {
            Size = UDim2.new(0, 240, 0, 180),
            BackgroundColor3 = CONFIG.Colors.Surface,
            BackgroundTransparency = 0.08,
            BorderSizePixel = 0,
            Parent = scrollFrame,
