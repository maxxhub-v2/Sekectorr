            Size = UDim2.new(1, -16, 0, 32),
            Position = UDim2.new(0.5, 0, 0, 36),
            AnchorPoint = Vector2.new(0.5, 0),
            BackgroundTransparency = 1,
            Text = desc,
            TextColor3 = S_COLORS.SubText,
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextWrapped = true,
            Parent = card,
            ZIndex = 11
        })

        -- Status indicator
        local statusColor = banRisk and S_COLORS.Error or (hasExternalKey and S_COLORS.Warning or S_COLORS.Success)
        local statusText = banRisk and "🔴 High ban risk" or (hasExternalKey and "🔑 External key" or "✓ Ready")
        
        local statusDot = Create("Frame", {
            Size = UDim2.new(0, 8, 0, 8),
            Position = UDim2.new(0, 14, 0, 76),
            BackgroundColor3 = statusColor,
            BorderSizePixel = 0,
            Parent = card,
            ZIndex = 11
        })
        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = statusDot})

        Create("TextLabel", {
            Size = UDim2.new(1, -36, 0, 16),
            Position = UDim2.new(0, 26, 0, 72),
            BackgroundTransparency = 1,
            Text = statusText,
            TextColor3 = statusColor,
            Font = Enum.Font.GothamBold,
            TextSize = 11,
            Parent = card,
            ZIndex = 11
        })

        -- Execute button container
        local execContainer = Create("Frame", {
            Size = UDim2.new(1, -16, 0, 44),
            Position = UDim2.new(0.5, 0, 0, 96),
            AnchorPoint = Vector2.new(0.5, 0),
            BackgroundTransparency = 1,
            Parent = card,
            ZIndex = 11
        })

        -- Execute button
        local execBtn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 40),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = color,
            BackgroundTransparency = 0.1,
            Text = "▶ EXECUTE",
            TextColor3 = S_COLORS.Text,
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            AutoButtonColor = false,
            Parent = execContainer,
            ZIndex = 12,
            ClipsDescendants = true
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 12), Parent = execBtn})
        Create("UIStroke", {Color = color, Transparency = 0.2, Thickness = 1.6, Parent = execBtn})

        -- Hover effects
        execBtn.MouseEnter:Connect(function()
            Tween(execBtn, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
                BackgroundTransparency = 0,
                Size = UDim2.new(1, 4, 0, 42)
            })
        end)
        execBtn.MouseLeave:Connect(function()
            Tween(execBtn, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
                BackgroundTransparency = 0.1,
                Size = UDim2.new(1, 0, 0, 40)
            })
        end)
        execBtn.MouseButton1Down:Connect(function(x, y)
            Ripple(execBtn, Vector2.new(x, y) - execBtn.AbsolutePosition)
            Tween(execBtn, 0.08, nil, nil, {Size = UDim2.new(0.97, 0, 0, 38)})
        end)
        execBtn.MouseButton1Up:Connect(function()
            Tween(execBtn, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {Size = UDim2.new(1, 4, 0, 42)})
        end)

        -- Execute logic — Delta safe
        execBtn.MouseButton1Click:Connect(function()
            execBtn.Text = "⚡ Executing..."
            execBtn.TextColor3 = S_COLORS.Success
            
            -- Webhook log (using global CONFIG if exists, else skip)
            local cleanName = name:gsub("[🔥💥⚡🌌🌀] ", "")
            if typeof(SendWebhook) == "function" then
                SendWebhook(cleanName, url)
            end
            
            -- Delta-safe execution
            task.spawn(function()
                local ok, result = pcall(function()
                    local src = game:HttpGet(url, true)
                    local fn = loadstring(src)
                    if not fn then error("Failed to compile") end
                    fn()
                end)
                if not ok then
                    warn("[MAXX HUB] Execution error: " .. tostring(result))
                    execBtn.Text = "✕ Failed"
                    execBtn.TextColor3 = S_COLORS.Error
                    task.wait(1.5)
                    execBtn.Text = "▶ EXECUTE"
                    execBtn.TextColor3 = S_COLORS.Text
                end
            end)
            
            task.wait(0.8)
            Tween(selectorFrame, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In, {Size = UDim2.new(0, 0, 0, 0), Rotation = 4})
            Tween(blurOverlay, 0.5, nil, nil, {BackgroundTransparency = 1})
            task.wait(0.5)
            screenGui:Destroy()
        end)

        return card
    end

