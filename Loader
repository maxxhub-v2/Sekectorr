            Size = UDim2.new(1, 0, 0, 3),
            Position = UDim2.new(0, 0, 0, 0),
            BackgroundColor3 = color,
            BorderSizePixel = 0,
            Parent = card,
            ZIndex = 11
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 3), Parent = accentLine})

        -- Card border
        Create("UIStroke", {Color = color, Transparency = 0.45, Thickness = 1.4, Parent = card})

        -- Script name
        Create("TextLabel", {
            Size = UDim2.new(1, -20, 0, 24),
            Position = UDim2.new(0.5, 0, 0, 14),
            AnchorPoint = Vector2.new(0.5, 0),
            BackgroundTransparency = 1,
            Text = name,
            TextColor3 = color,
            Font = Enum.Font.GothamBlack,
            TextSize = 18,
            Parent = card,
            ZIndex = 11
        })

        -- Description
        Create("TextLabel", {
            Size = UDim2.new(1, -20, 0, 36),
            Position = UDim2.new(0.5, 0, 0, 40),
            AnchorPoint = Vector2.new(0.5, 0),
            BackgroundTransparency = 1,
            Text = desc,
            TextColor3 = CONFIG.Colors.SubText,
            Font = Enum.Font.Gotham,
            TextSize = 11,
            TextWrapped = true,
            Parent = card,
            ZIndex = 11
        })

        -- Status indicator
        local statusColor = banRisk and CONFIG.Colors.Error or (hasExternalKey and CONFIG.Colors.Warning or CONFIG.Colors.Success)
        local statusText = banRisk and "🔴 High ban risk" or (hasExternalKey and "🔑 External key required" or "✓ Ready to execute")
        
        local statusDot = Create("Frame", {
            Size = UDim2.new(0, 8, 0, 8),
            Position = UDim2.new(0, 16, 0, 86),
            BackgroundColor3 = statusColor,
            BorderSizePixel = 0,
            Parent = card,
            ZIndex = 11
        })
        Create("UICorner", {CornerRadius = UDim.new(1, 0), Parent = statusDot})

        Create("TextLabel", {
            Size = UDim2.new(1, -40, 0, 16),
            Position = UDim2.new(0, 30, 0, 82),
            BackgroundTransparency = 1,
            Text = statusText,
            TextColor3 = statusColor,
            Font = Enum.Font.GothamBold,
            TextSize = 11,
            Parent = card,
            ZIndex = 11
        })

        -- Execute button container
        local execContainer = Create("Frame", {
            Size = UDim2.new(1, -20, 0, 50),
            Position = UDim2.new(0.5, 0, 0, 108),
            AnchorPoint = Vector2.new(0.5, 0),
            BackgroundTransparency = 1,
            Parent = card,
            ZIndex = 11
        })

        -- Execute button
        local execBtn = Create("TextButton", {
            Size = UDim2.new(1, 0, 0, 46),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            AnchorPoint = Vector2.new(0.5, 0.5),
            BackgroundColor3 = color,
            BackgroundTransparency = 0.1,
            Text = "▶ EXECUTE",
            TextColor3 = CONFIG.Colors.Text,
            Font = Enum.Font.GothamBlack,
            TextSize = 15,
            AutoButtonColor = false,
            Parent = execContainer,
            ZIndex = 12,
            ClipsDescendants = true
        })
        Create("UICorner", {CornerRadius = UDim.new(0, 12), Parent = execBtn})
        Create("UIStroke", {Color = color, Transparency = 0.2, Thickness = 1.8, Parent = execBtn})

        -- Button gradient
        Create("UIGradient", {
            Color = ColorSequence.new({
                ColorSequenceKeypoint.new(0, color),
                ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 255, 255)),
                ColorSequenceKeypoint.new(1, color)
            }),
            Transparency = NumberSequence.new(0.78, 0.85),
            Rotation = 90,
            Parent = execBtn
        })

        -- Hover effects
        execBtn.MouseEnter:Connect(function()
            Tween(execBtn, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
                BackgroundTransparency = 0,
                Size = UDim2.new(1, 4, 0, 48)
            })
        end)
        execBtn.MouseLeave:Connect(function()
            Tween(execBtn, 0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {
                BackgroundTransparency = 0.1,
                Size = UDim2.new(1, 0, 0, 46)
            })
        end)
        execBtn.MouseButton1Down:Connect(function(x, y)
            Ripple(execBtn, Vector2.new(x, y) - execBtn.AbsolutePosition)
            Tween(execBtn, 0.08, nil, nil, {Size = UDim2.new(0.97, 0, 0, 44)})
        end)
        execBtn.MouseButton1Up:Connect(function()
            Tween(execBtn, 0.2, Enum.EasingStyle.Quad, Enum.EasingDirection.Out, {Size = UDim2.new(1, 4, 0, 48)})
        end)

        -- Execute logic
        execBtn.MouseButton1Click:Connect(function()
            execBtn.Text = "⚡ Executing..."
            execBtn.TextColor3 = CONFIG.Colors.Success
            
            -- Webhook log
            local cleanName = name:gsub("[🔥💥⚡🌌🌀] ", "")
            SendWebhook(cleanName, url)
            
            task.spawn(function()
                ExecuteScript(url, nil, execBtn, "▶ EXECUTE")
            end)
            
            task.wait(0.8)
            Tween(selectorFrame, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.In, {Size = UDim2.new(0, 0, 0, 0), Rotation = 4})
            Tween(blurOverlay, 0.5, nil, nil, {BackgroundTransparency = 1})
            task.wait(0.5)
            screenGui:Destroy()
        end)

        return card
    end

